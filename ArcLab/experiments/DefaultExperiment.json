{
  "name": "Magnetic Particle Confinement Experiment",
  "description": "ArcLab MVP seed experiment: charged particles move through simplified electric and magnetic fields while sensors record live simulation metrics.",
  "engine_version": "0.1.0",
  "unit_system": "demo-si",
  "random_seed": 12345,
  "simulation": {
    "fixed_dt": 0.008333333333333333,
    "solver_iterations": 1,
    "accuracy": "preview",
    "max_particles": 100000,
    "boundary_radius": 8.0
  },
  "emitter": {
    "position": [-2.5, 0.0, 0.0],
    "direction": [1.0, 0.12, 0.18],
    "rate_per_second": 320.0,
    "speed": 7.5,
    "particle_mass": 1.0,
    "particle_charge": 1.0,
    "particle_lifetime": 5.0
  },
  "fields": [
    {
      "type": "magnetic",
      "direction": [0.0, 1.0, 0.0],
      "strength": 2.5,
      "enabled": true
    },
    {
      "type": "electric",
      "direction": [0.08, 0.0, 0.0],
      "strength": 0.35,
      "enabled": true
    }
  ],
  "recorders": {
    "sensors": [
      "average_velocity",
      "total_kinetic_energy",
      "active_particles",
      "average_distance_from_center",
      "lost_particles"
    ],
    "sample_rate_hz": 30,
    "export_format": "csv"
  }
}
